# Dependencies
node_modules/

# Generated media and runtime binaries
downloads/*
bin/*

# Keep generated directories available in fresh clones
!downloads/.gitkeep
!bin/.gitkeep

# Logs and local configuration
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# Operating system and editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json